# systemd unit for Meow Maker on the Amazon Linux 2023 EC2 instance.
#
# Installed by deploy/setup-instance.sh to /etc/systemd/system/. To reinstall
# manually:
#   sudo cp deploy/meow-maker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable meow-maker

[Unit]
Description=Meow Maker FastAPI server
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/meow-maker/server
ExecStart=/home/ec2-user/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
